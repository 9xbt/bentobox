name=xkeyboard-config
revision=1
from_source=xkeyboard-config
imagedeps="build-essential meson ninja-build"
hostdeps="gcc binutils pkgconfig xorg-util-macros"
deps="mlibc"

configure() {
	meson setup --cross-file=${base_dir}/crossfile-${JINX_ARCH}.txt --prefix=${prefix} ${source_dir}
}

build() {
	ninja
}

package() {
	DESTDIR=${dest_dir} ninja install
}