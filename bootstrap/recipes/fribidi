name=fribidi
revision=1
from_source=fribidi
imagedeps="build-essential meson ninja-build"
hostdeps="gcc binutils pkgconfig xorg-util-macros"
deps="mlibc"

configure() {
	meson setup --cross-file ${base_dir}/crossfile-${JINX_ARCH}.txt --prefix=${prefix} --default-library=shared ${source_dir}
}

build() {
	ninja
}

package() {
	DESTDIR=${dest_dir} ninja install
}