name=linux-headers
from_source=linux
revision=1
imagedeps="build-essential rsync"

build() {
	:
}

package() {
	cd ${source_dir}
	case "$JINX_ARCH" in
		x86_64)   ARCH=x86_64 ;;
		aarch64)  ARCH=arm64 ;;
		*)        echo "Unsupported architecture: $JINX_ARCH"; exit 1 ;;
	esac
	make headers_install ARCH=${ARCH} INSTALL_HDR_PATH=${dest_dir}/${prefix}/
}