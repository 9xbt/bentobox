name=libxcb
revision=1
from_source=libxcb
imagedeps="build-essential python3"
hostdeps="gcc binutils xorg-util-macros"
deps="mlibc xorg-util-macros xorgproto libXau libXdmcp xcb-proto"

configure() {
	cp -rp ${source_dir}/* .
    cp ${base_dir}/config.sub build-aux/
	./configure --host=${TARGET} --prefix=${prefix} --disable-static --with-sysroot=${sysroot_dir}
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}