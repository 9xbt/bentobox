name=fontconfig
revision=1
from_source=fontconfig
imagedeps="build-essential meson ninja-build gperf"
hostdeps="gcc binutils pkgconfig"
deps="mlibc freetype expat"

configure() {
	meson setup --cross-file ${base_dir}/crossfile-${JINX_ARCH}.txt --prefix=${prefix} --default-library=shared -Dc_args=-D_GNU_SOURCE ${source_dir}
}

build() {
	ninja
}

package() {
	DESTDIR=${dest_dir} ninja install
}