name=xvkbd
revision=1
from_source=xvkbd
imagedeps="build-essential"
hostdeps="gcc binutils pkgconfig xorg-util-macros"
deps="mlibc xorg-server libXmu libXpm libXt libXtst libXaw libXaw3d"

configure() {
	cp -rp ${source_dir}/* .
    cp ${base_dir}/config.sub .
	./configure --host=${TARGET} --prefix=${prefix}
}

build() {
	make -j${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}