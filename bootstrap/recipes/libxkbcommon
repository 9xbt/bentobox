name=libxkbcommon
revision=1
from_source=libxkbcommon
imagedeps="build-essential meson ninja-build"
hostdeps="gcc binutils pkgconfig xorg-util-macros"
deps="mlibc libxml2 xkeyboard-config libxcb"

configure() {
	meson setup --cross-file ${base_dir}/crossfile-${JINX_ARCH}.txt --prefix=${prefix} --default-library=shared -Denable-wayland=false ${source_dir}
}

build() {
	ninja
}

package() {
	DESTDIR=${dest_dir} ninja install
}