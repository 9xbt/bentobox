name=libxml2
revision=1
from_source=libxml2
imagedeps="build-essential meson ninja-build"
hostdeps="gcc binutils pkgconfig xorg-util-macros"
deps="mlibc libiconv"

configure() {
	meson setup --cross-file ${base_dir}/crossfile-${JINX_ARCH}.txt --prefix=${prefix} --buildtype=release --default-library=shared ${source_dir}
}

build() {
	ninja
}

package() {
	DESTDIR=${dest_dir} ninja install
}