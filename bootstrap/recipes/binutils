name=binutils
revision=1
from_source=binutils
imagedeps="build-essential"
hostdeps="gcc binutils"
deps="mlibc"

configure() {
	${source_dir}/configure --host=${TARGET} --target=${TARGET} --prefix=${prefix} --disable-nls --disable-werror --enable-default-execstack=no
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}