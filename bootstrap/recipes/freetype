name=freetype
revision=1
from_source=freetype
imagedeps="build-essential"
hostdeps="gcc binutils pkgconfig"
deps="mlibc"

configure() {
	cp -rp ${source_dir}/* .
    cp ${base_dir}/config.sub builds/unix/
	./configure --host=${TARGET} --prefix=${prefix} --disable-static
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}