name=libXext
revision=1
from_source=libXext
imagedeps="build-essential"
hostdeps="gcc binutils pkgconfig xorg-util-macros"
deps="mlibc libX11"

configure() {
	cp -rp ${source_dir}/* .
    cp ${base_dir}/config.sub .
	./configure --host=${TARGET} --prefix=${prefix} --disable-static --disable-malloc0returnsnull
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}