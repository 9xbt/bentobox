name=xorg-util-macros
revision=1
from_source=xorg-util-macros
imagedeps="build-essential"
hostdeps="gcc binutils pkgconfig"
deps="mlibc"

configure() {
	cp -rp ${source_dir}/* .
    cp ${base_dir}/config.sub .
	./configure --host=${TARGET} --prefix=${prefix}
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}