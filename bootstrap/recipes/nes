name=nes
revision=1
from_source=nes
imagedeps="build-essential cmake"
hostdeps="gcc binutils pkgconfig libstdc++-v3"
deps="mlibc sdl2 sdl2_ttf"

configure() {
	cmake -DPKG_CONFIG_EXECUTABLE="/usr/local/bin/${TARGET}-pkg-config" \
        -DCMAKE_TOOLCHAIN_FILE=${base_dir}/toolchain-${JINX_ARCH}.cmake \
        -DCMAKE_INSTALL_PREFIX=${prefix} \
        -DCMAKE_BUILD_TYPE=Release \
        ${source_dir}
}

build() {
	make -j${parallelism}
}

package() {
	mkdir -p ${dest_dir}/${prefix}/bin/
	cp nes ${dest_dir}/${prefix}/bin/
}