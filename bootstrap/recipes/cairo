name=cairo
revision=1
from_source=cairo
imagedeps="build-essential meson ninja-build"
hostdeps="gcc binutils pkgconfig"
deps="mlibc fontconfig freetype glib2 libpng libX11 libxcb libXext libXrender pixman zlib"

configure() {
	meson setup --cross-file ${base_dir}/crossfile-${JINX_ARCH}.txt --prefix=${prefix} --default-library=shared ${source_dir}
}

build() {
	ninja
}

package() {
	DESTDIR=${dest_dir} ninja install
}