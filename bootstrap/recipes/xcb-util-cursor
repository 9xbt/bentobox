name=xcb-util-cursor
revision=1
from_source=xcb-util-cursor
imagedeps="build-essential"
hostdeps="gcc binutils pkgconfig"
deps="mlibc libxcb xcb-util-image xcb-util-renderutil"

configure() {
	cp -rp ${source_dir}/* .
    cp ${base_dir}/config.sub .
	./configure --host=${TARGET} --prefix=${prefix}
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}