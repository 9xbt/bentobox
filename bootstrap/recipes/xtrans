name=xtrans
revision=1
from_source=xtrans
imagedeps="build-essential meson ninja-build"
hostdeps="gcc binutils pkgconfig xorg-util-macros"
deps="mlibc"

configure() {
	cp -rp ${source_dir}/* .
    cp ${base_dir}/config.sub .
	./configure --host=${TARGET} --prefix=${prefix}
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}