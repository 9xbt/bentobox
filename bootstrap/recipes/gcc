name=gcc
revision=1
from_source=gcc
imagedeps="build-essential flex"
hostdeps="gcc binutils libstdc++-v3"
deps="mlibc gmp mpfr mpc binutils"

configure() {
	${source_dir}/configure --host=${TARGET} --target=${TARGET} --prefix=${prefix} --enable-languages=c,c++ --with-sysroot=/ --with-build-sysroot=${sysroot_dir} --libexecdir=/usr/lib/gcc --disable-nls
}

build() {
	make all-gcc all-target-libgcc all-target-libstdc++-v3 -j${parallelism}
}

package() {
	make install-strip-gcc install-strip-target-libgcc install-strip-target-libstdc++-v3 DESTDIR=${dest_dir}
}