name=nasm
revision=1
from_source=nasm
imagedeps="build-essential"
hostdeps="gcc binutils pkgconfig"
deps="mlibc zlib"

configure() {
	cp -rp ${source_dir}/* .
    cp ${base_dir}/config.sub autoconf/helpers/
	./configure --host=${TARGET} --prefix=${prefix}
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}