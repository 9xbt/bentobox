name=mpc
revision=1
from_source=mpc
imagedeps="build-essential"
hostdeps="gcc binutils"
deps="mlibc gmp mpfr"

configure() {
	cp -rp ${source_dir}/* .
    cp ${base_dir}/config.sub build-aux/
	./configure --host=${TARGET} --prefix=${prefix}
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}