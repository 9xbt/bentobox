name=zlib
revision=1
from_source=zlib
imagedeps="build-essential patchelf"
hostdeps="gcc binutils"
deps="mlibc"

configure() {
	CHOST=${TARGET} prefix=${prefix} ${source_dir}/configure
}

build() {
	make -j ${parallelism}
}

package() {
    make install DESTDIR=${dest_dir}

    patchelf --set-soname libz.so.1 "${dest_dir}${prefix}/lib/libz.so.${version}"
}