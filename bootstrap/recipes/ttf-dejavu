name=ttf-dejavu
version=2.37
revision=1
imagedeps="unzip curl"
allow_network="yes"

build() {
    curl -L -o dejavu-fonts-ttf.zip "http://sourceforge.net/projects/dejavu/files/dejavu/${version}/dejavu-fonts-ttf-${version}.zip"
    unzip dejavu-fonts-ttf.zip
}

package() {
    mkdir -p ${dest_dir}/${prefix}/share/fonts/TTF
    mkdir -p ${dest_dir}/${prefix}/share/fontconfig/conf.avail/
    mkdir -p ${dest_dir}/etc/fonts/conf.d
    cp dejavu-fonts-ttf-${version}/ttf/*.ttf ${dest_dir}/${prefix}/share/fonts/TTF/
    cp dejavu-fonts-ttf-${version}/fontconfig/*.conf ${dest_dir}/${prefix}/share/fontconfig/conf.avail/

    for conf in dejavu-fonts-ttf-${version}/fontconfig/*.conf; do
        ln -sf ../../..${prefix}/share/fontconfig/conf.avail/$(basename "$conf") \
            ${dest_dir}/etc/fonts/conf.d/$(basename "$conf")
    done
}