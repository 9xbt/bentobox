name=cmatrix
revision=1
from_source=cmatrix
imagedeps="build-essential cmake"
hostdeps="gcc binutils pkgconfig"
deps="mlibc ncurses"

configure() {
	cmake -DPKG_CONFIG_EXECUTABLE="/usr/local/bin/${TARGET}-pkg-config" \
        -DCMAKE_TOOLCHAIN_FILE=${base_dir}/toolchain-${JINX_ARCH}.cmake \
        -DCMAKE_INSTALL_PREFIX=${prefix} \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS="-D_GNU_SOURCE" \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DCURSES_LIBRARY="-lncursesw" \
		-DCURSES_INCLUDE_PATH=${sysroot_dir}${prefix}/include/ncursesw \
        ${source_dir}
}

build() {
	make -j${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}