name=xf86-input-evdev
revision=1
from_source=xf86-input-evdev
imagedeps="build-essential"
hostdeps="gcc binutils pkgconfig xorg-util-macros"
deps="mlibc xorg-server libevdev mtdev"

configure() {
    cp -rp ${source_dir}/* .
    ACLOCAL_PATH="/usr/local/share/aclocal" autoreconf -fvi
    cp ${base_dir}/config.sub .
	./configure --host=${TARGET} --prefix=${prefix} --disable-static --with-sdkdir=${prefix}/include/xorg
}

build() {
    make -j${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}