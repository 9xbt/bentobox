name=gmp
revision=1
from_source=gmp
imagedeps="build-essential"
hostdeps="gcc binutils"
deps="mlibc"

configure() {
	cp -rp ${source_dir}/* .
    cp ${base_dir}/config.sub configfsf.sub
	./configure --host=${TARGET} --prefix=${prefix} CFLAGS="-std=gnu11"
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}