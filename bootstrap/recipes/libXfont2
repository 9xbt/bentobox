name=libXfont2
revision=1
from_source=libXfont2
imagedeps="build-essential"
hostdeps="gcc binutils pkgconfig xorg-util-macros"
deps="mlibc xorgproto freetype libfontenc zlib xtrans"

configure() {
	cp -rp ${source_dir}/* .
    cp ${base_dir}/config.sub .
	./configure --host=${TARGET} --prefix=${prefix} --disable-malloc0returnsnull
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}