name=glib2
revision=1
from_source=glib2
imagedeps="build-essential meson ninja-build"
hostdeps="gcc binutils libstdc++-v3 pkgconfig xorg-util-macros"
deps="mlibc libiconv pcre2 libffi zlib"
allow_network="yes"

configure() {
	meson setup --cross-file=${base_dir}/crossfile-${JINX_ARCH}.txt --prefix=${prefix} --buildtype=release -Dxattr=false ${source_dir}
}

build() {
	ninja
}

package() {
	DESTDIR=${dest_dir} ninja install
}