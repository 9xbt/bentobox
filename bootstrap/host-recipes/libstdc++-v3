name=libstdc++-v3
revision=1
from_source=gcc
imagedeps="build-essential"
hostdeps="gcc binutils"
deps="mlibc"

build() {
	cd ${base_dir}/build-${JINX_ARCH}/host-builds/gcc
	make all-target-libstdc++-v3 -j ${parallelism}
}

package() {
    cd ${base_dir}/build-${JINX_ARCH}/host-builds/gcc
    make install-target-libstdc++-v3 DESTDIR="${dest_dir}"
    rm -rf ${dest_dir}/usr/local/lib/gcc/${TARGET}/
    rm -f ${dest_dir}/usr/local/${TARGET}/lib/libgcc_s.so
    rm -f ${dest_dir}/usr/local/${TARGET}/lib/libgcc_s.so.1
    rm -rf ${dest_dir}/usr/local/share/gcc-*/
}