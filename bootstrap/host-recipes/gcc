name=gcc
revision=1
from_source=gcc
imagedeps="build-essential libmpfr-dev libmpc-dev libgmp-dev flex"
hostdeps="pkgconfig binutils"
deps="mlibc-headers"

configure() {
	mkdir -p ${sysroot_dir}/usr/lib
    touch ${sysroot_dir}/usr/lib/libc.so
    touch ${sysroot_dir}/usr/lib/libm.so
    touch ${sysroot_dir}/usr/lib/libpthread.so
	${source_dir}/configure --target=${TARGET} --prefix=${prefix} --with-sysroot=${sysroot_dir} --disable-nls --disable-multilib --disable-fixincludes --enable-languages=c,c++ -enable-threads=posix --enable-shared --enable-host-shared --enable-default-pie
}

build() {
	make all-gcc all-target-libgcc -j ${parallelism}
}

package() {
	make install-gcc install-target-libgcc DESTDIR="${dest_dir}"
}