#!/bin/bash
export ARCH="${1:-${ARCH:-x86_64}}"
CWD="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export TARGET=$ARCH-pc-bentobox
export TOOLCHAIN_PREFIX="$TARGET-"
export BASE="$CWD/base/$ARCH"
export MLIBC_ROOT="$BASE/usr"
export PATH="$CWD/../util/build/$ARCH/bin:$PATH"
mkdir -p $BASE
echo "BASE: $BASE"
echo "MLIBC_ROOT: $MLIBC_ROOT"